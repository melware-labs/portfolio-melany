---
// Tech marquee — infinite scroll of technologies
const techs = ['Python', 'Java', 'JavaScript', 'React', 'Node.js', 'Docker', 'Git', 'SQL', 'Linux', 'Spring Boot', 'REST APIs', 'TypeScript'];
---

<section class="py-6 border-y border-border overflow-hidden" aria-hidden="true">
  <div class="relative">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-bg to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-bg to-transparent z-10"></div>

    <div class="flex animate-[marquee_30s_linear_infinite] w-max">
      {[...techs, ...techs].map((tech, i) => (
        <span class="flex items-center gap-4 px-4">
          <span class="text-sm font-medium text-text-muted whitespace-nowrap">{tech}</span>
          {i < techs.length * 2 - 1 && <span class="text-text-dim">·</span>}
        </span>
      ))}
    </div>
  </div>
</section>
