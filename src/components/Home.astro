---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';
import StormHero from './StormHero.astro';
import melanyPhoto from '../assets/melany.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const email = 'melanymartinez667@gmail.com';
---

<!-- ── Portada ──────────────────────────────────────────────── -->
<section class="hero">
  <StormHero />
  <div class="container hero-copy">
    <p class="eyebrow">{t('hero.tagline')}</p>
    <h1>
      {t('hero.greeting')} <span class="hero-name">{t('hero.name')}</span>
    </h1>
    <p class="hero-intro prose">{t('hero.intro')}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#proyectos">{t('hero.ctaProjects')}</a>
      <a class="btn btn--secondary" href="#blog">{t('hero.ctaBlog')}</a>
    </div>
  </div>
</section>

<!-- ── Sobre mí ─────────────────────────────────────────────── -->
<section id="sobre-mi" class="section">
  <div class="container">
    <h2>{t('about.heading')}</h2>
    <div class="about-grid">
      <div class="prose">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>
      <aside class="about-aside">
        <Image
          class="about-photo"
          src={melanyPhoto}
          alt={t('about.photoAlt')}
          width={480}
          height={Math.round(480 * (melanyPhoto.height / melanyPhoto.width))}
        />
        <div class="card now-card">
          <h3>{t('about.nowHeading')}</h3>
          <p>{t('about.nowText')}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- ── Proyectos ────────────────────────────────────────────── -->
<section id="proyectos" class="section">
  <div class="container">
    <h2>{t('projects.heading')}</h2>
    <p class="section-intro prose">{t('projects.intro')}</p>

    {
      projects.length > 0 ? (
        <ul class="card-list">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('projects.empty')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Blog ─────────────────────────────────────────────────── -->
<section id="blog" class="section">
  <div class="container">
    <h2>{t('blog.heading')}</h2>
    <p class="section-intro prose">{t('blog.intro')}</p>

    {
      posts.length > 0 ? (
        <ul class="card-list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('blog.empty')}</p>
          <p>{t('blog.emptyHint')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────── -->
<section id="contacto" class="section">
  <div class="container">
    <h2>{t('contact.heading')}</h2>
    <p class="section-intro prose">{t('contact.intro')}</p>

    <form class="contact-form" id="contact-form">
      <div class="field">
        <label for="cf-name">{t('contact.formName')}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-email">{t('contact.formEmail')}</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-message">{t('contact.formMessage')}</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>
      <button class="btn btn--primary" type="submit">{t('contact.formSend')}</button>
    </form>

    <p class="contact-status" id="contact-status" role="status" hidden>
      {t('contact.sentMessage')}
      <span class="contact-email-row">
        <a href={`mailto:${email}`}>{email}</a>
        <button type="button" class="copy-email" id="copy-email" data-email={email}>
          {t('contact.copyEmail')}
        </button>
      </span>
    </p>

    <noscript>
      <p class="contact-noscript">
        {t('contact.noscript')}
        <a class="btn btn--secondary" href={`mailto:${email}`}>{t('contact.email')}</a>
      </p>
    </noscript>

    <script
      define:vars={{
        email,
        subjectPrefix: t('contact.formSubjectPrefix'),
        copyLabel: t('contact.copyEmail'),
        copiedLabel: t('contact.copied'),
      }}
    >
      const form = document.getElementById('contact-form');
      const status = document.getElementById('contact-status');

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const senderEmail = String(data.get('email') || '').trim();
        const message = String(data.get('message') || '').trim();

        const subject = encodeURIComponent(`${subjectPrefix} — ${name}`);
        const body = encodeURIComponent(`${message}\n\n—\n${name}\n${senderEmail}`);
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

        if (status) status.hidden = false;
      });

      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email || email);
          copyBtn.textContent = copiedLabel;
          setTimeout(() => {
            copyBtn.textContent = copyLabel;
          }, 2000);
        } catch {
          // Sin portapapeles disponible, el enlace de correo justo al lado sigue sirviendo.
        }
      });
    </script>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 10vw, 6rem);
    text-align: center;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    /* Sombra oscura detrás del texto: el contraste no depende de
       dónde caigan las partículas del canvas en cada fotograma. */
    background: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      color-mix(in srgb, var(--paper) 78%, transparent),
      transparent 72%
    );
    border-radius: var(--radius-lg);
    padding-block: var(--space-4);
  }
  .hero-name {
    color: var(--accent);
  }
  .hero-intro {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ── Sobre mí ─────────────────────────────────────────────── */
  .about-grid {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .about-aside {
    display: grid;
    gap: var(--space-5);
    /* En móvil la tarjeta no necesita más ancho que la foto */
    max-width: 18rem;
  }
  .about-photo {
    width: 100%;
    height: auto;
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-lg);
  }
  .now-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }
  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }

  .section-intro {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .section-intro + .card-list,
  .section-intro + .empty,
  .section-intro + .btn {
    margin-top: var(--space-6);
  }

  /* Lista sin viñetas: son tarjetas, pero semánticamente sigue
     siendo una lista para quien use lector de pantalla. */
  .card-list {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    /* Dos columnas sólo si hay varias tarjetas; con una sola
       ocuparía media pantalla y parecería que falta algo. */
    .card-list:has(> li + li) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Formulario de contacto ─────────────────────────────────── */
  .contact-form {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
    max-width: 32rem;
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  .field label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .field input,
  .field textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .contact-form .btn {
    justify-self: start;
  }
  .contact-status {
    margin-top: var(--space-6);
    max-width: 32rem;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .contact-status[hidden] {
    display: none;
  }
  .contact-email-row {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .copy-email {
    font: inherit;
    color: var(--ink);
    background: var(--paper-2);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .copy-email:hover {
    background: var(--surface);
  }
  .contact-noscript {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-soft);
  }

</style>
