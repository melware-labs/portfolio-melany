---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const email = 'melanymartinez667@gmail.com';
---

<!-- ── Portada ──────────────────────────────────────────────── -->
<section class="hero">
  <div class="container hero-copy">
    <p class="eyebrow">{t('hero.tagline')}</p>
    <h1>
      {t('hero.greeting')} <span class="hero-name">{t('hero.name')}</span>
    </h1>
    <p class="hero-intro prose">{t('hero.intro')}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#proyectos">{t('hero.ctaProjects')}</a>
      <a class="btn btn--secondary" href="#blog">{t('hero.ctaBlog')}</a>
    </div>
  </div>
</section>

<!-- ── Proyectos ────────────────────────────────────────────── -->
<section id="proyectos" class="section">
  <div class="container">
    <h2>{t('projects.heading')}</h2>
    <p class="section-intro prose">{t('projects.intro')}</p>

    {
      projects.length > 0 ? (
        <ul class="card-list">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('projects.empty')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Blog ─────────────────────────────────────────────────── -->
<section id="blog" class="section section--alt">
  <div class="container">
    <h2>{t('blog.heading')}</h2>
    <p class="section-intro prose">{t('blog.intro')}</p>

    {
      posts.length > 0 ? (
        <ul class="card-list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('blog.empty')}</p>
          <p>{t('blog.emptyHint')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────── -->
<section id="contacto" class="section">
  <div class="container">
    <h2>{t('contact.heading')}</h2>
    <p class="section-intro prose">{t('contact.intro')}</p>
    <a class="btn btn--primary" href={`mailto:${email}`}>{t('contact.email')}</a>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 6rem);
    text-align: center;
  }
  .hero-name {
    color: var(--accent);
  }
  .hero-intro {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .section-intro {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .section-intro + .card-list,
  .section-intro + .empty,
  .section-intro + .btn {
    margin-top: var(--space-6);
  }

  /* Lista sin viñetas: son tarjetas, pero semánticamente sigue
     siendo una lista para quien use lector de pantalla. */
  .card-list {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    /* Dos columnas sólo si hay varias tarjetas; con una sola
       ocuparía media pantalla y parecería que falta algo. */
    .card-list:has(> li + li) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>
