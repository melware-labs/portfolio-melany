---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';
import AboutCard from './AboutCard.astro';
import Splash from './Splash.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const allPosts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
// La portada sólo adelanta los más recientes; el blog completo — con sus
// categorías — vive en /blog.
const BLOG_PREVIEW_COUNT = 3;
const posts = allPosts.slice(0, BLOG_PREVIEW_COUNT);

/**
 * Días que una novedad sigue siendo novedad: una semana por publicación.
 * Pasados estos, la viñeta "New" del botón desaparece sola.
 *
 * Se calcula dos veces a propósito: aquí, al construir el sitio, para no
 * meter la viñeta en el HTML si ya está caducada; y otra vez en el navegador
 * (ver el <script> del final), porque una web estática se queda congelada en
 * el momento del despliegue y sin esa segunda vuelta la viñeta seguiría ahí
 * meses después, hasta la siguiente publicación.
 */
const NEW_DAYS = 7;

/** Cuándo deja de ser nueva la fecha más reciente de una lista. */
function freshUntil(dates: (Date | undefined)[]): Date | null {
  const newest = dates.filter((d): d is Date => d instanceof Date).sort((a, b) => b.getTime() - a.getTime())[0];
  if (!newest) return null;
  const until = new Date(newest.getTime() + NEW_DAYS * 24 * 60 * 60 * 1000);
  return until > new Date() ? until : null;
}

const projectsNewUntil = freshUntil(projects.map((p) => p.data.date));
const postsNewUntil = freshUntil(posts.map((p) => p.data.date));

const COURSE_REPO = 'https://github.com/melware-labs/JAVA';
const courseTopics = t('course.topics').split('|');

const email = 'melanymartinez667@gmail.com';

// Nombres propios: no se traducen entre idiomas.
const stack = ['Astro', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Three.js'];
---

<Splash />

<!-- ── Portada ──────────────────────────────────────────────── -->
<section class="hero">
  <div class="container hero-copy">
    <h1 class="animate-fade-up" style="animation-delay: 0.05s">
      <span class="hero-fade">{t('hero.greeting')}</span> <span class="hero-name">{t('hero.name')}</span>
    </h1>
    <p class="hero-intro prose animate-fade-up" style="animation-delay: 0.15s">{t('hero.intro')}</p>
    <div class="hero-actions animate-fade-up" style="animation-delay: 0.25s">
      <a class="btn btn--primary" href="#proyectos">
        {t('hero.ctaProjects')}
        {projectsNewUntil && (
          <span class="btn-new" data-new-until={projectsNewUntil.toISOString()}>
            <span aria-hidden="true">{t('hero.new')}</span>
            <span class="visually-hidden">{t('hero.newSr')}</span>
          </span>
        )}
      </a>
      <a class="btn btn--secondary" href="#blog">
        {t('hero.ctaBlog')}
        {postsNewUntil && (
          <span class="btn-new" data-new-until={postsNewUntil.toISOString()}>
            <span aria-hidden="true">{t('hero.new')}</span>
            <span class="visually-hidden">{t('hero.newSr')}</span>
          </span>
        )}
      </a>
    </div>
  </div>
</section>

<!-- ── Sobre mí ─────────────────────────────────────────────── -->
<section id="sobre-mi" class="section scroll-fade">
  <div class="container">
    <h2>{t('about.heading')}</h2>
    <div class="about-grid">
      <div class="prose">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>
      <div class="about-aside">
        <AboutCard />
      </div>
    </div>
  </div>
</section>

<!-- ── Stack ────────────────────────────────────────────────────
     Va justo antes de los proyectos, a modo de entradilla: primero las
     herramientas, después lo construido con ellas. Entre la portada y
     "Sobre mí" sólo cortaba la presentación. -->
<section class="section stack-section scroll-fade">
  <div class="stack-marquee">
    <div class="stack-track">
      <ul class="stack-group">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      {
        // Nueve copias más de refuerzo (ocultas a lectores de pantalla).
        // Con pocas copias, en pantallas muy anchas (monitores grandes,
        // 4K) la tira no llega a cubrir el hueco entero y se ve un
        // corte justo antes de que reaparezca texto. Repetir texto no
        // cuesta nada, así que de sobra es más seguro que ajustado.
        Array.from({ length: 9 }).map(() => (
          <ul class="stack-group" aria-hidden="true">
            {stack.map((item) => <li>{item}</li>)}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  // La viñeta "New" trae escrito hasta cuándo vale. El HTML lo generó el
  // despliegue y ahí se quedó congelado, así que si desde entonces han
  // pasado los días, se quita aquí: si no, seguiría anunciando como nuevo
  // algo de hace meses hasta que Melany volviera a publicar.
  document.querySelectorAll<HTMLElement>('[data-new-until]').forEach((badge) => {
    const until = new Date(badge.dataset.newUntil ?? '');
    if (!(until > new Date())) badge.remove();
  });

  // Tira de tecnologías: se desplaza sola sin parar, y sólo se congela
  // mientras se mantiene pulsada — de ahí que no baste con pasar el
  // cursor por encima. Mientras está pulsada, arrastrar a los lados
  // adelanta o retrasa la tira a mano, como si fuera una cinta física.
  const marquee = document.querySelector<HTMLElement>('.stack-marquee');
  const track = document.querySelector<HTMLElement>('.stack-track');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (marquee && track && !reducedMotion) {
    // Debe coincidir con la duración de @keyframes stack-scroll de abajo:
    // es lo que traduce un desplazamiento en píxeles a tiempo de animación.
    const DURATION_MS = 26000;

    let dragging = false;
    let pointerId: number | null = null;
    let startX = 0;
    let startTime = 0;
    /** Píxeles que recorre la tira por milisegundo de animación. */
    let pxPerMs = 0;

    function measureSpeed() {
      const group = track!.firstElementChild as HTMLElement | null;
      const groupWidth = group?.getBoundingClientRect().width || 1;
      // La animación recorre exactamente el ancho de una copia (ver el
      // comentario junto a stack-scroll), así que la velocidad sale directa.
      pxPerMs = groupWidth / DURATION_MS;
    }
    measureSpeed();
    window.addEventListener('resize', measureSpeed);

    function handlePointerDown(event: PointerEvent) {
      const [animation] = track!.getAnimations();
      if (!animation) return;

      dragging = true;
      pointerId = event.pointerId;
      startX = event.clientX;
      startTime = Number(animation.currentTime) || 0;
      animation.pause();
      marquee!.classList.add('is-dragging');
      marquee!.setPointerCapture(event.pointerId);
    }

    function handlePointerMove(event: PointerEvent) {
      if (!dragging || event.pointerId !== pointerId || pxPerMs === 0) return;
      const [animation] = track!.getAnimations();
      if (!animation) return;

      // Arrastrar hacia la izquierda adelanta la tira (igual que su
      // dirección normal); hacia la derecha, la retrasa.
      const dx = event.clientX - startX;
      animation.currentTime = startTime - dx / pxPerMs;
    }

    function endDrag(event: PointerEvent) {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      pointerId = null;
      marquee!.classList.remove('is-dragging');
      if (marquee!.hasPointerCapture(event.pointerId)) {
        marquee!.releasePointerCapture(event.pointerId);
      }
      const [animation] = track!.getAnimations();
      animation?.play();
    }

    marquee.addEventListener('pointerdown', handlePointerDown);
    marquee.addEventListener('pointermove', handlePointerMove);
    marquee.addEventListener('pointerup', endDrag);
    marquee.addEventListener('pointercancel', endDrag);
  }
</script>

<!-- ── Proyectos ────────────────────────────────────────────── -->
<section id="proyectos" class="section scroll-fade">
  <div class="container">
    <h2>{t('projects.heading')}</h2>
    <p class="section-intro prose">{t('projects.intro')}</p>

    {
      projects.length > 0 ? (
        <ul class="card-list projects-grid">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('projects.empty')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Curso ────────────────────────────────────────────────── -->
<section id="curso" class="section scroll-fade">
  <div class="container">
    <h2>{t('course.heading')}</h2>
    <p class="section-intro prose">{t('course.intro')}</p>

    <article class="card course">
      <svg class="course-logo" viewBox="0 0 554 554" aria-hidden="true">
        <!-- Vapor (rojo del portfolio) -->
        <path class="steam" fill="var(--accent)" fill-rule="evenodd" d="M 332.648 14.248 C 334.426 22.730, 334.333 38.470, 332.453 47.575 C 327.064 73.665, 311.448 92.827, 266 129.119 C 237.925 151.538, 227.476 161.040, 219.654 171.265 C 200.084 196.845, 201.999 218.251, 226.819 251.336 C 234.124 261.075, 263.973 291.861, 273.084 299.056 L 277.445 302.500 273.623 295.500 C 271.522 291.650, 265.437 282.200, 260.103 274.500 C 236.804 240.866, 231.341 226.293, 234.933 207.353 C 238.501 188.537, 250.158 172.905, 277.950 149.666 C 310.418 122.516, 327.146 103.116, 337.603 80.483 C 347.470 59.129, 347.551 35.071, 337.820 16.813 C 332.828 7.448, 331.037 6.560, 332.648 14.248 M 377.500 123.367 C 305.569 148.562, 269.642 185.771, 279.366 225 C 281.871 235.104, 290.076 250.449, 298.650 261.063 C 309.267 274.208, 311.500 279.236, 311.500 290 C 311.500 300.078, 309.180 306.018, 301.617 315.303 L 296.900 321.095 301.200 318.335 C 325.454 302.773, 338.507 285.329, 338.493 268.500 C 338.484 257.932, 336.761 253.825, 325.768 238.174 C 304.348 207.676, 303.461 193.655, 321.630 172.745 C 332.197 160.584, 351.339 145.776, 378 129.138 C 397.262 117.118, 395.810 118.118, 394 118.115 C 393.175 118.114, 385.750 120.477, 377.500 123.367" />
        <!-- Taza y plato (tinta del portfolio) -->
        <path fill="var(--ink)" fill-rule="evenodd" d="M 416.855 300.889 C 410.745 302.465, 402.146 307.480, 403.402 308.736 C 403.696 309.029, 405.413 308.647, 407.218 307.886 C 413.399 305.282, 428.619 306.036, 434.713 309.248 C 445.335 314.847, 450.874 321.837, 452.993 332.314 C 456.977 352.014, 437.561 376.600, 401.906 397.009 C 385.877 406.183, 387.556 407.171, 407.500 400.299 C 451.854 385.017, 477.544 360.337, 475.742 334.741 C 473.959 309.426, 446.026 293.368, 416.855 300.889 M 200 305.075 C 171.541 307.457, 126.710 322.699, 121.938 331.616 C 111.858 350.450, 233.632 358.635, 327.940 345.462 C 352.754 341.997, 366.314 338.501, 374.705 333.408 C 378.990 330.806, 384.747 327.588, 387.498 326.255 C 392.115 324.018, 392.231 323.879, 389 324.454 C 373.217 327.263, 333.690 332.524, 318 333.904 C 283.526 336.935, 271.430 337.443, 233 337.470 C 188.715 337.502, 175.419 336.423, 165.250 331.972 C 160.526 329.905, 159.522 326.613, 162.750 323.767 C 167.337 319.723, 184.952 312.691, 204.750 307 C 211.248 305.131, 214.120 303.763, 210.750 304.140 C 210.063 304.217, 205.225 304.638, 200 305.075 M 183.300 369.414 C 157.260 380.142, 157.910 392.140, 185 400.800 C 191.607 402.912, 201.088 404.893, 215.500 407.173 C 226.437 408.903, 280.922 408.922, 295.500 407.201 C 318.878 404.441, 352.675 398.455, 361.066 395.589 C 361.854 395.319, 364.525 394.578, 367 393.941 L 371.500 392.784 364.500 389.263 C 360.650 387.327, 355.771 384.380, 353.657 382.714 L 349.814 379.684 333.157 382.390 C 287.181 389.856, 236.911 391.170, 201.500 385.831 C 186.342 383.546, 182.277 377.767, 189.658 368.995 C 191.044 367.348, 192.025 366.008, 191.839 366.018 C 191.653 366.028, 187.810 367.557, 183.300 369.414 M 199.971 426.442 C 176.186 435.208, 174.005 445.933, 193.887 456.366 C 203.564 461.445, 216.621 464.828, 238.692 467.975 C 249.242 469.479, 284.662 469.237, 298.108 467.569 C 317.847 465.121, 349.595 456.944, 359.487 451.761 C 361.961 450.465, 361.896 450.401, 355.250 447.546 C 351.537 445.952, 344.900 442.738, 340.500 440.404 L 332.500 436.160 321.500 438.071 C 292.432 443.121, 271.333 444.583, 249 443.097 C 207.376 440.326, 194.292 435.981, 202.591 427.682 C 205.559 424.714, 205.165 424.527, 199.971 426.442 M 139.500 464.620 C 110.382 468.780, 78 484.562, 78 494.594 C 78 503.284, 88.177 507.434, 120.500 511.924 C 226.458 526.642, 338.273 523.388, 410.108 503.495 C 449.062 492.708, 462.872 478.709, 444.120 469.020 C 441.776 467.809, 441.764 467.826, 443.370 470.118 C 454.935 486.629, 416.703 498.003, 327.500 504.586 C 286.849 507.587, 212.361 507.007, 176 503.407 C 141.937 500.035, 115.441 493.257, 112.686 487.209 C 111.660 484.959, 111.911 484.416, 115.345 481.447 C 121.949 475.739, 142.130 468.862, 156.641 467.375 C 166.035 466.413, 163.123 464.638, 151.746 464.392 C 146.661 464.281, 141.150 464.384, 139.500 464.620 M 471.366 500.880 C 445.494 523.948, 333.958 541.745, 238 538.117 C 202.435 536.772, 161.428 533.538, 152.041 531.337 C 147.757 530.333, 150.985 532.564, 157.012 534.773 C 179.239 542.921, 217.230 546.475, 282 546.466 C 393.599 546.451, 462.681 530.632, 474.482 502.389 C 476.724 497.023, 476.055 496.699, 471.366 500.880" />
      </svg>
      <div class="course-body">
        <span class="course-badge">{t('course.status')}</span>
        <h3>{t('course.cardTitle')}</h3>
        <p class="course-text">{t('course.cardText')}</p>
        <ul class="course-topics">
          {courseTopics.map((topic) => <li>{topic}</li>)}
        </ul>
        <a class="btn btn--primary course-cta" href={COURSE_REPO} target="_blank" rel="noopener noreferrer">
          {t('course.cta')} &rarr;
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .course {
    display: grid;
    grid-template-columns: auto 1fr;
    margin-top: var(--space-6);
    align-items: center;
    gap: var(--space-6);
  }
  .course-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .course-logo {
    width: clamp(7rem, 20vw, 10.5rem);
    height: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .steam {
      animation: steam-rise 3.2s ease-in-out infinite;
    }
    @keyframes steam-rise {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(-12px); opacity: 0.6; }
    }
  }
  @media (max-width: 40rem) {
    .course {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
  .course-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.2rem var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--paper);
  }
  .course-text {
    color: var(--ink-soft);
  }
  .course-topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .course-topics li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius);
    padding: 0.1rem var(--space-2);
  }
  .course-cta {
    margin-top: var(--space-2);
  }
</style>

<!-- ── Blog ─────────────────────────────────────────────────── -->
<section id="blog" class="section scroll-fade">
  <div class="container">
    <h2>{t('blog.heading')}</h2>
    <p class="section-intro prose">{t('blog.intro')}</p>

    {
      posts.length > 0 ? (
        <>
          <ul class="card-list posts-grid">
            {posts.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
          <a class="btn btn--secondary blog-view-all" href={localizedPath('/blog', lang)}>
            {t('blog.viewAll')} &rarr;
          </a>
        </>
      ) : (
        <div class="empty">
          <p>{t('blog.empty')}</p>
          <p>{t('blog.emptyHint')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────── -->
<section id="contacto" class="section scroll-fade">
  <div class="container contact-grid">
    <div class="contact-intro">
      <h2>{t('contact.heading')}</h2>
      <p class="section-intro prose">{t('contact.intro')}</p>
    </div>

    <div class="contact-form-col">
      <form class="contact-form" id="contact-form">
        <div class="field-row">
          <div class="field">
            <label for="cf-name" class="visually-hidden">{t('contact.formName')}</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={t('contact.formName')}
              required
            />
          </div>
          <div class="field">
            <label for="cf-email" class="visually-hidden">{t('contact.formEmail')}</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder={t('contact.formEmail')}
              required
            />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="cf-subject" class="visually-hidden">{t('contact.formSubject')}</label>
            <input
              id="cf-subject"
              name="subject"
              type="text"
              placeholder={t('contact.formSubject')}
              required
            />
          </div>
          <div class="field">
            <label for="cf-phone" class="visually-hidden">{t('contact.formPhone')}</label>
            <input
              id="cf-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder={t('contact.formPhoneOptional')}
            />
          </div>
        </div>
        <div class="field">
          <label for="cf-message" class="visually-hidden">{t('contact.formMessage')}</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            placeholder={t('contact.formMessage')}
            required
          ></textarea>
        </div>
        <div class="contact-form-actions">
          <button class="btn btn--primary" type="submit" id="contact-submit">
            {t('contact.formSend')}
          </button>
          <button
            type="button"
            class="contact-reset"
            id="contact-reset"
            aria-label={t('contact.formSendAnother')}
            hidden
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
          </button>
        </div>
      </form>

      <p class="contact-status" id="contact-status" role="status" hidden>
        <span id="contact-status-text"></span>
        <span class="contact-email-row" id="contact-status-fallback" hidden>
          <a href={`mailto:${email}`}>{email}</a>
          <button type="button" class="copy-email" id="copy-email" data-email={email}>
            {t('contact.copyEmail')}
          </button>
        </span>
      </p>

      <noscript>
        <p class="contact-noscript">
          {t('contact.noscript')}
          <a class="btn btn--secondary" href={`mailto:${email}`}>{t('contact.email')}</a>
        </p>
      </noscript>
    </div>

    <script
      define:vars={{
        email,
        accessKey: '7d9b8989-913c-4fbe-ae7a-1468d954cf2f',
        subjectPrefix: t('contact.formSubjectPrefix'),
        errorMessage: t('contact.errorMessage'),
        sendingLabel: t('contact.formSending'),
        sendLabel: t('contact.formSend'),
        sentLabel: t('contact.formSent'),
        copyLabel: t('contact.copyEmail'),
        copiedLabel: t('contact.copied'),
      }}
    >
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('contact-submit');
      const resetBtn = document.getElementById('contact-reset');
      const status = document.getElementById('contact-status');
      const statusText = document.getElementById('contact-status-text');
      const statusFallback = document.getElementById('contact-status-fallback');

      function showError(text) {
        if (!status || !statusText || !statusFallback) return;
        statusText.textContent = text;
        statusFallback.hidden = false;
        status.hidden = false;
      }

      function hideError() {
        if (status) status.hidden = true;
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        const data = new FormData(form);
        const userSubject = String(data.get('subject') || '').trim();
        data.set('subject', `${subjectPrefix}: ${userSubject}`);
        data.append('access_key', accessKey);

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = sendingLabel;
        }

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: data,
          });
          const result = await res.json();
          if (result.success) {
            if (submitBtn) submitBtn.textContent = sentLabel;
            if (resetBtn) resetBtn.hidden = false;
          } else {
            showError(errorMessage);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = sendLabel;
            }
          }
        } catch {
          showError(errorMessage);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = sendLabel;
          }
        }
      });

      resetBtn?.addEventListener('click', () => {
        form?.reset();
        hideError();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = sendLabel;
        }
        resetBtn.hidden = true;
      });

      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email || email);
          copyBtn.textContent = copiedLabel;
          setTimeout(() => {
            copyBtn.textContent = copyLabel;
          }, 2000);
        } catch {
          // Sin portapapeles disponible, el enlace de correo justo al lado sigue sirviendo.
        }
      });
    </script>
  </div>
</section>

