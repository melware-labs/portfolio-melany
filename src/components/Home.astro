---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const email = 'melanymartinez667@gmail.com';
---

<!-- ── Portada ──────────────────────────────────────────────── -->
<section class="hero">
  <div class="container hero-copy">
    <p class="eyebrow">{t('hero.tagline')}</p>
    <h1>
      {t('hero.greeting')} <span class="hero-name">{t('hero.name')}</span>
    </h1>
    <p class="hero-intro prose">{t('hero.intro')}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#proyectos">{t('hero.ctaProjects')}</a>
      <a class="btn btn--secondary" href="#blog">{t('hero.ctaBlog')}</a>
    </div>
  </div>
</section>

<!-- ── Proyectos ────────────────────────────────────────────── -->
<section id="proyectos" class="section">
  <div class="container">
    <h2>{t('projects.heading')}</h2>
    <p class="section-intro prose">{t('projects.intro')}</p>

    {
      projects.length > 0 ? (
        <ul class="card-list">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('projects.empty')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Blog ─────────────────────────────────────────────────── -->
<section id="blog" class="section section--alt">
  <div class="container">
    <h2>{t('blog.heading')}</h2>
    <p class="section-intro prose">{t('blog.intro')}</p>

    {
      posts.length > 0 ? (
        <ul class="card-list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('blog.empty')}</p>
          <p>{t('blog.emptyHint')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────── -->
<section id="contacto" class="section">
  <div class="container contact-grid">
    <div>
      <h2>{t('contact.heading')}</h2>
      <p class="section-intro prose">{t('contact.intro')}</p>

      <form class="contact-form" id="contact-form" data-email={email}>
        <div class="form-row">
          <label class="form-field">
            <span>{t('contact.formName')}</span>
            <input type="text" name="name" autocomplete="name" />
          </label>
          <label class="form-field">
            <span>{t('contact.formEmail')} *</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label class="form-field">
          <span>{t('contact.formSubject')}</span>
          <input type="text" name="subject" />
        </label>
        <label class="form-field">
          <span>{t('contact.formMessage')} *</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <p class="form-error" id="contact-form-error" hidden>{t('contact.formError')}</p>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">{t('contact.formSubmit')}</button>
          <p class="form-note">{t('contact.formNote')}</p>
        </div>
      </form>

      <p class="contact-alt">
        {t('contact.or')} <a href={`mailto:${email}`}>{t('contact.email').toLowerCase()}</a>
      </p>
    </div>

    <aside class="card social-card">
      <h3>{t('contact.social')}</h3>
      <ul class="social-list">
        <li>
          <a href="https://github.com/" target="_blank" rel="me noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.56-.01 2.81-.01 3.19 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/></svg>
            GitHub
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/" target="_blank" rel="me noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/" target="_blank" rel="me noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            Instagram
          </a>
        </li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 6rem);
    text-align: center;
  }
  .hero-name {
    color: var(--accent);
  }
  .hero-intro {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .section-intro {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .section-intro + .card-list,
  .section-intro + .empty,
  .section-intro + .btn,
  .section-intro + .contact-form {
    margin-top: var(--space-6);
  }

  /* Lista sin viñetas: son tarjetas, pero semánticamente sigue
     siendo una lista para quien use lector de pantalla. */
  .card-list {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    /* Dos columnas sólo si hay varias tarjetas; con una sola
       ocuparía media pantalla y parecería que falta algo. */
    .card-list:has(> li + li) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Contacto ─────────────────────────────────────────────── */
  .contact-grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 55rem) {
    .contact-grid {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
  }
  .form-row {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 30rem) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form-field {
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .form-field input,
  .form-field textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-width) solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }
  .form-field textarea {
    resize: vertical;
  }
  .form-field input:invalid:not(:placeholder-shown) {
    border-color: var(--accent);
  }

  .form-error {
    font-size: var(--step--1);
    color: var(--accent);
  }
  .form-error[hidden] {
    display: none;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .form-note {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .contact-alt {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .social-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }
  .social-list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .social-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .social-list a:hover {
    color: var(--accent);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('contact-form-error');

  // Sin backend propio (aún no hay web publicada ni hosting elegido), así
  // que el formulario compone un correo con lo escrito y lo abre en el
  // programa de correo de quien visita — funciona en cualquier sitio,
  // sin cuentas ni claves de por medio.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const from = String(data.get('email') ?? '').trim();
    const subject = String(data.get('subject') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    if (!from || !message) {
      errorEl?.removeAttribute('hidden');
      return;
    }
    errorEl?.setAttribute('hidden', '');

    const to = form.dataset.email;
    const body = `${message}\n\n— ${name || from} (${from})`;
    const params = new URLSearchParams({
      subject: subject || `Mensaje de ${name || from}`,
      body,
    });
    window.location.href = `mailto:${to}?${params.toString()}`;
  });
</script>
