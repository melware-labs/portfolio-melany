---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';
import SocialLinks from './SocialLinks.astro';
import melanyPhoto from '../assets/melany.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const posts = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const email = 'melanymartinez667@gmail.com';

// Nombres propios: no se traducen entre idiomas.
const stack = ['Astro', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Three.js'];
---

<!-- ── Portada ──────────────────────────────────────────────── -->
<section class="hero">
  <div class="container hero-copy">
    <h1>
      <span class="hero-fade">{t('hero.greeting')}</span> <span class="hero-name">{t('hero.name')}</span>
    </h1>
    <p class="hero-intro prose">{t('hero.intro')}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#proyectos">{t('hero.ctaProjects')}</a>
      <a class="btn btn--secondary" href="#blog">{t('hero.ctaBlog')}</a>
    </div>
  </div>
</section>

<!-- ── Stack ────────────────────────────────────────────────── -->
<section class="section stack-section">
  <div class="stack-marquee">
    <div class="stack-track">
      <ul class="stack-group">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      {
        // Nueve copias más de refuerzo (ocultas a lectores de pantalla).
        // Con pocas copias, en pantallas muy anchas (monitores grandes,
        // 4K) la tira no llega a cubrir el hueco entero y se ve un
        // corte justo antes de que reaparezca texto. Repetir texto no
        // cuesta nada, así que de sobra es más seguro que ajustado.
        Array.from({ length: 9 }).map(() => (
          <ul class="stack-group" aria-hidden="true">
            {stack.map((item) => <li>{item}</li>)}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<!-- ── Sobre mí ─────────────────────────────────────────────── -->
<section id="sobre-mi" class="section">
  <div class="container">
    <h2>{t('about.heading')}</h2>
    <div class="about-grid">
      <div class="prose">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>
      <div class="about-aside">
        <!-- Gafete colgando de un cordón: se balancea solo y responde
             un poco al ratón (perspective + rotateX/Y), sin ninguna
             librería de física — ver el <script> al final del archivo. -->
        <div class="badge-wrap" id="about-badge-wrap">
          <span class="badge-ring" aria-hidden="true"></span>
          <div class="badge-rig">
            <span class="badge-strap" aria-hidden="true"></span>
            <div class="badge-card" id="about-badge-card">
              <Image
                class="badge-photo"
                src={melanyPhoto}
                alt={t('about.photoAlt')}
                width={400}
                height={Math.round(400 * (melanyPhoto.height / melanyPhoto.width))}
              />
              <div class="badge-plate">
                <p class="badge-name">Melany Martínez</p>
                <p class="badge-role">{t('about.badgeRole')}</p>
              </div>
            </div>
          </div>
        </div>
        <SocialLinks />
      </div>
    </div>
  </div>

  <script>
    // Tilt del gafete al pasar el ratón: sólo con puntero fino (no táctil)
    // y sólo si no han pedido menos movimiento. El balanceo en reposo es
    // pura animación CSS y ya respeta prefers-reduced-motion desde base.css.
    const wrap = document.getElementById('about-badge-wrap');
    const card = document.getElementById('about-badge-card');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (wrap && card && finePointer && !reducedMotion) {
      let frame = 0;

      const applyTilt = (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty('--ry', `${(px * 16).toFixed(2)}deg`);
        card.style.setProperty('--rx', `${(py * -16).toFixed(2)}deg`);
        frame = 0;
      };

      wrap.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => applyTilt(event));
      });

      wrap.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    }
  </script>
</section>

<!-- ── Proyectos ────────────────────────────────────────────── -->
<section id="proyectos" class="section">
  <div class="container">
    <h2>{t('projects.heading')}</h2>
    <p class="section-intro prose">{t('projects.intro')}</p>

    {
      projects.length > 0 ? (
        <ul class="card-list projects-grid">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('projects.empty')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Blog ─────────────────────────────────────────────────── -->
<section id="blog" class="section">
  <div class="container">
    <h2>{t('blog.heading')}</h2>
    <p class="section-intro prose">{t('blog.intro')}</p>

    {
      posts.length > 0 ? (
        <ul class="card-list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>{t('blog.empty')}</p>
          <p>{t('blog.emptyHint')}</p>
        </div>
      )
    }
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────── -->
<section id="contacto" class="section">
  <div class="container contact-grid">
    <div class="contact-intro">
      <h2>{t('contact.heading')}</h2>
      <p class="section-intro prose">{t('contact.intro')}</p>
    </div>

    <div class="contact-form-col">
      <form class="contact-form" id="contact-form">
        <div class="field-row">
          <div class="field">
            <label for="cf-name" class="visually-hidden">{t('contact.formName')}</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={t('contact.formName')}
              required
            />
          </div>
          <div class="field">
            <label for="cf-email" class="visually-hidden">{t('contact.formEmail')}</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder={t('contact.formEmail')}
              required
            />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="cf-subject" class="visually-hidden">{t('contact.formSubject')}</label>
            <input
              id="cf-subject"
              name="subject"
              type="text"
              placeholder={t('contact.formSubject')}
              required
            />
          </div>
          <div class="field">
            <label for="cf-phone" class="visually-hidden">{t('contact.formPhone')}</label>
            <input
              id="cf-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder={t('contact.formPhoneOptional')}
            />
          </div>
        </div>
        <div class="field">
          <label for="cf-message" class="visually-hidden">{t('contact.formMessage')}</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            placeholder={t('contact.formMessage')}
            required
          ></textarea>
        </div>
        <div class="contact-form-actions">
          <button class="btn btn--primary" type="submit" id="contact-submit">
            {t('contact.formSend')}
          </button>
          <button
            type="button"
            class="contact-reset"
            id="contact-reset"
            aria-label={t('contact.formSendAnother')}
            hidden
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
          </button>
        </div>
      </form>

      <p class="contact-status" id="contact-status" role="status" hidden>
        <span id="contact-status-text"></span>
        <span class="contact-email-row" id="contact-status-fallback" hidden>
          <a href={`mailto:${email}`}>{email}</a>
          <button type="button" class="copy-email" id="copy-email" data-email={email}>
            {t('contact.copyEmail')}
          </button>
        </span>
      </p>

      <noscript>
        <p class="contact-noscript">
          {t('contact.noscript')}
          <a class="btn btn--secondary" href={`mailto:${email}`}>{t('contact.email')}</a>
        </p>
      </noscript>
    </div>

    <script
      define:vars={{
        email,
        accessKey: '7d9b8989-913c-4fbe-ae7a-1468d954cf2f',
        subjectPrefix: t('contact.formSubjectPrefix'),
        errorMessage: t('contact.errorMessage'),
        sendingLabel: t('contact.formSending'),
        sendLabel: t('contact.formSend'),
        sentLabel: t('contact.formSent'),
        copyLabel: t('contact.copyEmail'),
        copiedLabel: t('contact.copied'),
      }}
    >
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('contact-submit');
      const resetBtn = document.getElementById('contact-reset');
      const status = document.getElementById('contact-status');
      const statusText = document.getElementById('contact-status-text');
      const statusFallback = document.getElementById('contact-status-fallback');

      function showError(text) {
        if (!status || !statusText || !statusFallback) return;
        statusText.textContent = text;
        statusFallback.hidden = false;
        status.hidden = false;
      }

      function hideError() {
        if (status) status.hidden = true;
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        const data = new FormData(form);
        const userSubject = String(data.get('subject') || '').trim();
        data.set('subject', `${subjectPrefix} — ${userSubject}`);
        data.append('access_key', accessKey);

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = sendingLabel;
        }

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: data,
          });
          const result = await res.json();
          if (result.success) {
            if (submitBtn) submitBtn.textContent = sentLabel;
            if (resetBtn) resetBtn.hidden = false;
          } else {
            showError(errorMessage);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = sendLabel;
            }
          }
        } catch {
          showError(errorMessage);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = sendLabel;
          }
        }
      });

      resetBtn?.addEventListener('click', () => {
        form?.reset();
        hideError();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = sendLabel;
        }
        resetBtn.hidden = true;
      });

      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email || email);
          copyBtn.textContent = copiedLabel;
          setTimeout(() => {
            copyBtn.textContent = copyLabel;
          }, 2000);
        } catch {
          // Sin portapapeles disponible, el enlace de correo justo al lado sigue sirviendo.
        }
      });
    </script>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 10vw, 6rem);
    text-align: center;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    /* Sombra oscura detrás del texto: el contraste no depende de
       dónde caigan las partículas del canvas en cada fotograma. */
    background: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      color-mix(in srgb, var(--paper) 78%, transparent),
      transparent 72%
    );
    border-radius: var(--radius-lg);
    padding-block: var(--space-4);
  }
  .hero-copy h1 {
    font-size: clamp(2.8rem, 1.8rem + 6vw, 6rem);
    letter-spacing: -0.03em;
  }
  .hero-fade {
    background: linear-gradient(
      to bottom,
      var(--ink),
      color-mix(in srgb, var(--ink) 55%, transparent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-name {
    color: var(--accent);
  }
  .hero-intro {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ── Stack ────────────────────────────────────────────────── */
  .stack-section {
    padding-block: var(--space-6);
    border-block: var(--border-width) solid color-mix(in srgb, var(--ink) 8%, transparent);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
  }
  .stack-marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }
  .stack-track {
    display: flex;
    width: max-content;
    animation: stack-scroll 26s linear infinite;
  }
  .stack-marquee:hover .stack-track,
  .stack-marquee:focus-within .stack-track {
    animation-play-state: paused;
  }
  .stack-group {
    display: flex;
    gap: var(--space-8);
    list-style: none;
    padding-inline-end: var(--space-8);
  }
  .stack-group li {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    white-space: nowrap;
    color: var(--ink-soft);
  }
  @keyframes stack-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Se mueve exactamente el ancho de una copia (1 de 10 = 10% del
         total), no medio total — con más de dos copias, "la mitad"
         ya no es una copia entera. */
      transform: translateX(-10%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-track {
      animation: none;
    }
    .stack-group[aria-hidden] {
      display: none;
    }
  }

  /* ── Sobre mí ─────────────────────────────────────────────── */
  .about-grid {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .about-aside {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    /* Más arriba que el texto, para que no arranque a la misma
       altura y se sienta menos encajonada. */
    margin-top: -3rem;
  }
  /* Gafete con cordón, foto y nombre — reemplaza la foto suelta. */
  .badge-wrap {
    position: relative;
    display: grid;
    justify-items: center;
    padding-top: 3rem;
    /* Da aire para que el tilt del gafete no recorte contra el borde. */
    perspective: 900px;
  }
  .badge-ring {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.8rem;
    height: 0.8rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--ink-soft);
    box-shadow: inset 0 0 0 2px var(--paper);
  }
  .badge-rig {
    transform-origin: top center;
    animation: badge-swing 5s ease-in-out infinite;
  }
  /* En reposo se para al pasar el ratón: el tilt manda mientras se interactúa. */
  .badge-wrap:hover .badge-rig,
  .badge-wrap:focus-within .badge-rig {
    animation-play-state: paused;
  }
  .badge-strap {
    display: block;
    width: 1.5rem;
    height: 2.75rem;
    margin-inline: auto;
    background: var(--accent);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 7px,
      color-mix(in srgb, var(--paper) 45%, transparent) 7px 8px
    );
    clip-path: polygon(18% 0, 82% 0, 100% 100%, 0% 100%);
  }
  .badge-card {
    --rx: 0deg;
    --ry: 0deg;
    width: 16rem;
    max-width: 100%;
    margin-top: -0.2rem;
    background: var(--surface);
    border: var(--border-width) solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.4s ease;
  }
  .badge-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .badge-plate {
    padding: var(--space-3) var(--space-4);
    border-top: var(--border-width) solid color-mix(in srgb, var(--ink) 16%, transparent);
    text-align: center;
  }
  .badge-name {
    font-family: var(--font-display);
    font-weight: 700;
  }
  .badge-role {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  @keyframes badge-swing {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }
  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }

  .section-intro {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .section-intro + .card-list,
  .section-intro + .empty,
  .section-intro + .btn {
    margin-top: var(--space-6);
  }

  /* Lista sin viñetas: son tarjetas, pero semánticamente sigue
     siendo una lista para quien use lector de pantalla. */
  .card-list {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    /* Dos columnas sólo si hay varias tarjetas; con una sola
       ocuparía media pantalla y parecería que falta algo. */
    .card-list:has(> li + li) {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Proyectos concretamente en "bento" — una tarjeta más ancha que
       la otra, como el grid de la referencia — en vez de dos iguales. */
    .projects-grid:has(> li + li) {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  /* ── Formulario de contacto ─────────────────────────────────── */
  .contact-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .contact-form {
    display: grid;
    gap: var(--space-4);
    max-width: 36rem;
  }
  .field-row {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 30rem) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .contact-form-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .contact-reset {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .contact-reset:hover {
    color: var(--accent);
  }
  .contact-reset[hidden] {
    display: none;
  }
  .contact-status {
    margin-top: var(--space-6);
    max-width: 32rem;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .contact-status[hidden] {
    display: none;
  }
  .contact-email-row[hidden] {
    display: none;
  }
  .contact-email-row {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .copy-email {
    font: inherit;
    color: var(--ink);
    background: var(--paper-2);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .copy-email:hover {
    background: var(--surface);
  }
  .contact-noscript {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-soft);
  }

</style>
