---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, status, repo, url, tech } = project.data;
---

<article class="card project">
  <header class="project-head">
    <h3>{title}</h3>
    {status === 'wip' && <span class="badge">{t('projects.inProgress')}</span>}
  </header>

  <p class="project-desc">{description}</p>

  {
    tech.length > 0 && (
      <ul class="tech">
        {tech.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  {
    (repo || url) && (
      <p class="project-links">
        {repo && <a href={repo}>{t('projects.viewCode')}</a>}
        {url && <a href={url}>{t('projects.viewLive')}</a>}
      </p>
    )
  }
</article>

<style>
  .project {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  /* Chapa roja sólida con el texto en negro — es como la referencia marca
     lo destacado. Negro sobre el rojo y no blanco: ahí el contraste sube
     de 4,2 a 4,9 y sí pasa el mínimo de accesibilidad. */
  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.2rem var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--paper);
  }

  .project-desc {
    color: var(--ink-soft);
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius);
    padding: 0.1rem var(--space-2);
  }

  /* Los enlaces de la tarjeta en micro-texto de mono y mayúsculas, como
     el pie de las tarjetas de la referencia, en vez de enlaces
     subrayados en medio del bloque. */
  .project-links {
    display: flex;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .project-links a {
    text-decoration: none;
  }
  .project-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
