---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, status, repo, url, tech } = project.data;
---

<article class="card project">
  <header class="project-head">
    <h3>{title}</h3>
    {status === 'wip' && <span class="badge">{t('projects.inProgress')}</span>}
  </header>

  <p class="project-desc">{description}</p>

  {
    tech.length > 0 && (
      <ul class="tech">
        {tech.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  {
    (repo || url) && (
      <p class="project-links">
        {repo && <a href={repo}>{t('projects.viewCode')}</a>}
        {url && <a href={url}>{t('projects.viewLive')}</a>}
      </p>
    )
  }
</article>

<style>
  .project {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem var(--space-2);
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius);
    color: var(--ink-muted);
  }

  .project-desc {
    color: var(--ink-soft);
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 0.1rem var(--space-2);
  }

  .project-links {
    display: flex;
    gap: var(--space-4);
    font-weight: 600;
  }
</style>
