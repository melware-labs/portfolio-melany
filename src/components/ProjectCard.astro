---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, status, repo, url, tech } = project.data;
---

<article class="card project">
  <header class="project-head">
    <h3>
      {url ? <a href={url} class="title-link">{title}</a> : title}
    </h3>
    {repo && (
      <a href={repo} class="repo-link" aria-label={t('projects.viewCode')} title={t('projects.viewCode')}>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.56-.01 2.81-.01 3.19 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" fill="currentColor"/>
        </svg>
      </a>
    )}
  </header>

  <p class="project-desc">{description}</p>

  <div class="project-footer">
    {status === 'wip' && <span class="badge">{t('projects.inProgress')}</span>}

    {
      tech.length > 0 && (
        <ul class="tech">
          {tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>

</article>

<style>
  .project {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-head {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .project-head h3 {
    /* Permitir que el título haga salto de línea si es largo, sin encogerse */
    flex: 1 1 auto;
  }

  .title-link {
    text-decoration: none;
    color: inherit;
  }
  .title-link:hover {
    text-decoration: underline;
  }

  .repo-link {
    margin-left: auto;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    /* Evitar que el icono se encoja o cambie de tamaño si el título empuja */
    flex: 0 0 auto;
  }
  .repo-link:hover {
    color: var(--ink);
  }

  /* Chapa roja sólida con el texto en negro — es como la referencia marca
     lo destacado. Negro sobre el rojo y no blanco: ahí el contraste sube
     de 4,2 a 4,9 y sí pasa el mínimo de accesibilidad. */
  .badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.2rem var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--paper);
  }

  .project-desc {
    color: var(--ink-soft);
  }

  .project-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius);
    padding: 0.1rem var(--space-2);
  }

</style>
