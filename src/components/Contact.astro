---
// Contact section with form and social links
---

<section id="contacto" class="py-(--section-padding) scroll-mt-20">
  <div class="max-w-(--container-max) mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
      <!-- Left -->
      <div data-reveal>
        <p class="text-primary text-sm font-mono font-medium uppercase tracking-wider mb-3">Contacto</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-text mb-6">¿Hablamos?</h2>
        <p class="text-text-muted leading-relaxed mb-8">
          Si tienes algún proyecto en mente, quieres colaborar, o simplemente
          quieres hablar sobre tech, escríbeme. Respondo siempre.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href="https://github.com/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-border text-text-muted text-sm hover:border-border-hover hover:text-text transition-all duration-200 no-underline"
            aria-label="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a
            href="https://linkedin.com/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-border text-text-muted text-sm hover:border-border-hover hover:text-text transition-all duration-200 no-underline"
            aria-label="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a
            href="mailto:melany@example.com"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-border text-text-muted text-sm hover:border-border-hover hover:text-text transition-all duration-200 no-underline"
            aria-label="Email"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div data-reveal data-reveal-delay="1">
        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-text text-sm font-medium mb-1.5">Nombre *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="given-name"
                placeholder="Tu nombre"
                class="w-full px-4 py-2.5 rounded-lg bg-bg-card border border-border text-text text-sm placeholder:text-text-dim focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all duration-200"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-text text-sm font-medium mb-1.5">Email *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                placeholder="tu@email.com"
                class="w-full px-4 py-2.5 rounded-lg bg-bg-card border border-border text-text text-sm placeholder:text-text-dim focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all duration-200"
              />
            </div>
          </div>
          <div>
            <label for="contact-subject" class="block text-text text-sm font-medium mb-1.5">Asunto</label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              placeholder="¿De qué va?"
              class="w-full px-4 py-2.5 rounded-lg bg-bg-card border border-border text-text text-sm placeholder:text-text-dim focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all duration-200"
            />
          </div>
          <div>
            <label for="contact-message" class="block text-text text-sm font-medium mb-1.5">Mensaje *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Cuéntame..."
              class="w-full px-4 py-2.5 rounded-lg bg-bg-card border border-border text-text text-sm placeholder:text-text-dim focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all duration-200 resize-y"
            ></textarea>
          </div>
          <p id="form-error" class="text-accent text-sm hidden"></p>
          <button
            type="submit"
            id="form-submit"
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary text-white font-medium text-sm hover:bg-primary-hover transition-all duration-200 cursor-pointer border-none shadow-[0_0_20px_rgba(129,140,248,0.2)] hover:shadow-[0_0_30px_rgba(129,140,248,0.4)]"
          >
            <span id="btn-text">Enviar mensaje</span>
            <svg id="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Contact form validation
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = (data.get('name') as string)?.trim();
    const email = (data.get('email') as string)?.trim();
    const message = (data.get('message') as string)?.trim();

    if (!name || !email || !message) {
      if (errorEl) {
        errorEl.textContent = 'Por favor, rellena los campos obligatorios.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (errorEl) {
        errorEl.textContent = 'El email no parece válido.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    // Success placeholder
    if (errorEl) errorEl.classList.add('hidden');
    const btnText = document.getElementById('btn-text');
    if (btnText) btnText.textContent = '¡Mensaje enviado! ✓';
    form.reset();
    setTimeout(() => {
      if (btnText) btnText.textContent = 'Enviar mensaje';
    }, 3000);
  });
</script>
