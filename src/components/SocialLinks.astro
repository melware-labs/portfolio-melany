---
/**
 * Enlaces a redes sociales, compartidos entre el footer y Sobre mí.
 * Las URLs y los iconos viven en src/data/social.ts, porque el gafete 3D
 * también los pinta y no deben poder quedarse desincronizados.
 */
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { socialLinks } from '../data/social';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class:list={['social-links', className]} aria-label={t('footer.social')}>
  {
    socialLinks.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="me noopener noreferrer" aria-label={link.label}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            {link.paths.map((path) => (
              <path
                d={path.d}
                fill={path.mode === 'fill' ? 'currentColor' : 'none'}
                stroke={path.mode === 'stroke' ? 'currentColor' : 'none'}
                stroke-width="2"
              />
            ))}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
  }
  .social-links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink-soft);
    border-radius: var(--radius);
  }
  .social-links a:hover {
    color: var(--accent);
    background: var(--surface);
  }
</style>
