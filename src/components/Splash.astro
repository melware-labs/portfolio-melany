---
/**
 * Splash de bienvenida del inicio: aparece el nombre "<Melany" centrado y
 * se reduce a "<M", el logo de la marca, antes de desvanecerse y dejar a la
 * vista la web.
 *
 * El texto sale de la misma clave de i18n que el hero (hero.name), para que
 * no se pueda desincronizar: la "M" es sólo el primer carácter, separado del
 * resto para poder animar el resto aparte.
 */
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = t('hero.name');
const initial = name.slice(0, 1);
const rest = name.slice(1);
---

<!-- aria-hidden: es decoración, y duplica un texto que el hero real ya
     ofrece a los lectores de pantalla sin esperar la animación. -->
<div class="splash" data-splash aria-hidden="true">
  <p class="splash-line">
    <span class="splash-mark">&lt;</span><span class="splash-initial">{initial}</span
    ><span class="splash-rest"><span class="splash-rest-text">{rest}</span></span>
  </p>
</div>

<noscript>
  <style>
    /* Sin JS nadie retiraría la capa: mejor no mostrarla nunca que
       dejarla tapando la web para siempre. */
    [data-splash] {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .splash {
    position: fixed;
    inset: 0;
    /* Por encima de todo lo demás: el máximo del resto de la web es el
       300 del .skip-link. */
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--paper);
  }
  .splash[hidden] {
    display: none;
  }

  /* Mismo tamaño y tipografía que el titular del hero. */
  .splash-line {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.8rem, 1.8rem + 6vw, 6rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
    color: var(--ink);
    white-space: nowrap;
    /* En reposo no se pinta nada: si no, el nombre asomaría antes de
       arrancar y daría un salto al empezar. */
    opacity: 0;
  }
  .splash.is-playing .splash-line {
    animation: splash-in 0.5s ease-out both;
  }

  /* El "<" y la "M" son el logo: mismos colores que el favicon y la marca
     de la cabecera. */
  .splash-mark {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }
  .splash-initial {
    color: var(--ink);
  }

  /* El resto del nombre se pliega hasta ancho 0 con una rejilla de una
     columna que pasa de 1fr a 0fr: así el ancho se anima de verdad y el
     "<M" que queda sigue centrado sin medir nada con JS. `overflow: clip`
     y no `hidden` para no cambiar la línea base del texto; el colchón de
     abajo y de la derecha evita cortar la "y" (descendente y
     letter-spacing negativo). */
  .splash-rest {
    display: inline-grid;
    grid-template-columns: 1fr;
  }
  .splash-rest-text {
    min-width: 0;
    overflow: clip;
    padding-inline-end: 0.08em;
    padding-bottom: 0.35em;
    margin-bottom: -0.35em;
  }
  .splash.is-playing .splash-rest {
    animation: splash-collapse 0.7s cubic-bezier(0.65, 0, 0.35, 1) 1.5s both;
  }
  .splash.is-playing .splash-rest-text {
    animation: splash-rest-out 0.5s ease-in 1.5s both;
  }
  /* El último paso es el fade de la capa entera. */
  .splash.is-playing {
    animation: splash-fade-out 0.45s ease-in 2.7s both;
  }

  @keyframes splash-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes splash-collapse {
    from {
      grid-template-columns: 1fr;
    }
    to {
      grid-template-columns: 0fr;
    }
  }
  @keyframes splash-rest-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes splash-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>

<script>
  const splash = document.querySelector<HTMLElement>('[data-splash]');

  if (splash) {
    const SEEN_KEY = 'splash-seen';
    // sessionStorage puede lanzar (modo privado con almacenamiento
    // bloqueado): si no se puede leer ni escribir, se anima y punto.
    function seen(): boolean {
      try {
        return sessionStorage.getItem(SEEN_KEY) !== null;
      } catch {
        return false;
      }
    }
    function markSeen() {
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch {
        // Sin memoria de sesión se repetirá; no es motivo para fallar.
      }
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /**
     * Con un ancla en la URL (los enlaces del menú apuntan a /#sobre-mi y
     * compañía desde el resto de páginas) no hay splash: quien pide una
     * sección concreta no está entrando por la puerta principal, y el
     * bloqueo del scroll se comía justamente ese salto a la sección.
     */
    const deepLink = window.location.hash.length > 1;

    /** Retira la capa del todo. Es el único camino de salida. */
    function dismiss() {
      splash!.classList.remove('is-playing');
      splash!.hidden = true;
      document.documentElement.style.overflow = '';
      window.removeEventListener('pointerdown', dismiss);
      window.removeEventListener('keydown', dismiss);
    }

    if (seen() || reducedMotion || deepLink) {
      // Ya vista en esta sesión, movimiento reducido, o se ha pedido una
      // sección concreta: la web aparece montada, sin animación ninguna.
      dismiss();
      markSeen();
    } else {
      markSeen();
      // Mientras se reproduce no se puede hacer scroll: la capa tapa la
      // página entera, así que scrollear a ciegas sólo desorienta.
      document.documentElement.style.overflow = 'hidden';

      // El último paso de la coreografía es el fade de la capa entera;
      // cuando acaba, se retira. Se comprueba el target porque las
      // animaciones de los hijos también burbujean hasta aquí.
      splash.addEventListener('animationend', (event) => {
        if (event.target === splash && event.animationName === 'splash-fade-out') {
          dismiss();
        }
      });

      // Cualquier clic, toque o tecla la salta.
      window.addEventListener('pointerdown', dismiss);
      window.addEventListener('keydown', dismiss);

      void play();
    }

    /** Arranca cuando la fuente está lista, para que no cambie de forma a mitad. */
    async function play() {
      if (document.fonts) {
        try {
          await document.fonts.ready;
        } catch {
          // Si falla, se arranca con lo que haya cargado.
        }
      }
      splash!.classList.add('is-playing');
    }
  }
</script>
