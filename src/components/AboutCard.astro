---
/**
 * Tarjeta de "Sobre mí": foto, nombre y enlaces. Antes colgaba de un gafete
 * 3D en WebGL (Three.js) con física de péndulo; se quitó a petición de
 * Melany y esto es lo que queda — la misma tarjeta plana que ya servía de
 * respaldo cuando el 3D no cargaba, ahora como única versión.
 */
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import melanyPhoto from '../assets/melany.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = 'Melany Martínez';
---

<div class="about-card">
  <Image
    class="about-card-photo"
    src={melanyPhoto}
    alt={t('about.photoAlt')}
    width={400}
    height={Math.round(400 * (melanyPhoto.height / melanyPhoto.width))}
  />
  <div class="about-card-plate">
    <p class="about-card-name">{name}</p>
    <SocialLinks class="about-card-links" />
  </div>
</div>

<style>
  .about-card {
    width: 16rem;
    max-width: 100%;
    margin-inline: auto;
    background: var(--surface);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .about-card-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about-card-plate {
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-top: 3px solid var(--accent);
    text-align: center;
  }
  .about-card-name {
    font-family: var(--font-display);
    font-weight: 700;
  }
  .about-card-links {
    justify-content: center;
    margin-top: var(--space-2);
    gap: var(--space-2);
  }
</style>
