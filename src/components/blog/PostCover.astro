---
/**
 * Portada ilustrada de un post: SVG hecho a mano, no una foto. Por defecto
 * pinta el icono genérico de la categoría; si el post trae `cover` con el
 * nombre de una ilustración concreta (ver namedCovers más abajo), usa esa
 * en su lugar — así el post de vibe coding puede llevar su propio dibujo
 * en vez del icono compartido de "programación".
 *
 * Es decorativa (aria-hidden): el título del post ya dice de qué va, esto
 * es sólo apoyo visual.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { BlogCategory } from '../../data/blog-categories';
import CoverAi from './covers/CoverAi.astro';
import CoverProgramming from './covers/CoverProgramming.astro';
import CoverCareer from './covers/CoverCareer.astro';
import CoverStudentLife from './covers/CoverStudentLife.astro';
import CoverVibeCoding from './covers/CoverVibeCoding.astro';

interface Props {
  category: BlogCategory;
  cover?: string;
  class?: string;
}
const { category, cover, class: className } = Astro.props;

const categoryIcons: Record<BlogCategory, AstroComponentFactory> = {
  ai: CoverAi,
  programming: CoverProgramming,
  career: CoverCareer,
  'student-life': CoverStudentLife,
};

// Ilustraciones con nombre propio, ligadas a un post concreto y no a una
// categoría entera. Añadir una nueva: un caso aquí + su componente en covers/.
const namedCovers: Record<string, AstroComponentFactory> = {
  'vibe-coding': CoverVibeCoding,
};

// De estos, cuáles son fotos reales en vez de iconos SVG: una foto necesita
// más alto que la franja fina de los iconos para no recortar lo importante
// (ver la regla `.post-cover--photo` más abajo), así que el panel cambia de
// forma según lo que va dentro.
const PHOTO_COVERS = new Set(['vibe-coding']);
const isPhoto = cover ? PHOTO_COVERS.has(cover) : false;

const Icon = (cover && namedCovers[cover]) || categoryIcons[category];
---

<div
  class:list={['post-cover', { 'post-cover--photo': isPhoto }, className]}
  aria-hidden="true"
>
  <Icon />
</div>

<style>
  .post-cover {
    /* Franja baja, no un panel cuadrado: la ilustración es apoyo, no la
       protagonista de la card — antes con 16/9 se comía media tarjeta. */
    aspect-ratio: 3 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius);
    border: var(--border-width) solid var(--line);
    background:
      radial-gradient(
        ellipse 70% 70% at 28% 20%,
        color-mix(in srgb, var(--accent) 10%, transparent),
        transparent 70%
      ),
      var(--surface);
  }
  .post-cover :global(svg) {
    width: 22%;
    height: 22%;
    color: var(--ink-soft);
  }
  /* Una foto necesita más alto que la franja de 3/1 de los iconos: ahí
     recortaba tanto que se perdían el gato y la pantalla a la vez. 4/3
     deja ver ambos sin estirar nada. */
  .post-cover--photo {
    aspect-ratio: 4 / 3;
  }
  /* Las fotos (a diferencia de los iconos SVG) van a sangre: rellenan todo
     el panel y se recortan al recuadro, en vez de quedar centradas a un
     tamaño pequeño. object-position sube el foco hacia el tercio superior,
     que es donde están la cara del gato y la pantalla en la foto original;
     lo que se recorta es la parte de abajo (teclado), la menos importante. */
  .post-cover :global(.post-cover-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
</style>
