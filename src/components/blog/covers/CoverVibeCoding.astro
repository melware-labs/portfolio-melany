---
/**
 * Portada específica del post de vibe coding: la foto real que puso Melany
 * (un gato flipando delante de la pantalla), no un icono genérico — por eso
 * vive fuera del switch de categorías de PostCover.astro. La clase
 * "post-cover-photo" es la que le dice a PostCover.astro que la trate como
 * foto (a sangre, recortada) y no como icono centrado.
 */
import { Image } from 'astro:assets';
import vibeCodingCat from '../../../assets/blog/vibecoding-cat.jpg';
---

<Image
  class="post-cover-photo"
  src={vibeCodingCat}
  alt=""
  width={800}
  height={Math.round(800 * (vibeCodingCat.height / vibeCodingCat.width))}
/>
