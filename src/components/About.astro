---
// About section with skills grid
const skills = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    name: 'Desarrollo Full-Stack',
    desc: 'Java · Python · JavaScript · React · Node.js',
    color: 'primary',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    name: 'Bases de Datos',
    desc: 'MySQL · PostgreSQL · MongoDB · SQL',
    color: 'green',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>`,
    name: 'DevOps & Cloud',
    desc: 'Docker · Git · Linux · CI/CD',
    color: 'purple',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
    name: 'IA & Machine Learning',
    desc: 'Python · TensorFlow · Scikit-learn',
    color: 'amber',
  },
];

const colorMap: Record<string, string> = {
  primary: 'text-primary bg-primary/10',
  green: 'text-green bg-green/10',
  purple: 'text-purple bg-purple/10',
  amber: 'text-amber bg-amber/10',
};
---

<section id="sobre-mi" class="py-(--section-padding) scroll-mt-20">
  <div class="max-w-(--container-max) mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Left: text -->
      <div data-reveal>
        <p class="text-primary text-sm font-mono font-medium uppercase tracking-wider mb-3">Sobre mí</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-text mb-6">
          Apasionada por crear software con impacto real
        </h2>
        <p class="text-text-muted leading-relaxed mb-4">
          Soy Melany, estudiante de <strong class="text-text font-medium">Ingeniería del Software en la Universidad de Málaga</strong> (UMA).
          Me mueve la curiosidad de entender cómo funciona la tecnología y usarla para construir
          cosas que importen.
        </p>
        <p class="text-text-muted leading-relaxed mb-8">
          Además de desarrollar proyectos propios, escribo sobre las tendencias que más me
          interesan: IA, arquitecturas de software, web moderna y todo lo que está cambiando
          nuestra forma de programar.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#proyectos"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:bg-primary-hover transition-all duration-200 no-underline"
          >
            Ver mis proyectos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="https://github.com/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-text-muted text-sm font-medium hover:border-border-hover hover:text-text transition-all duration-200 no-underline"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- Right: skills -->
      <div data-reveal data-reveal-delay="1">
        <div class="grid gap-4">
          {skills.map(skill => (
            <div class="flex items-start gap-4 p-4 rounded-xl border border-border bg-bg-card hover:bg-bg-card-hover hover:border-border-hover transition-all duration-300 group">
              <div class={`shrink-0 w-10 h-10 rounded-lg flex items-center justify-center ${colorMap[skill.color]}`}>
                <Fragment set:html={skill.icon} />
              </div>
              <div>
                <h3 class="font-display font-semibold text-text text-sm mb-0.5">{skill.name}</h3>
                <p class="text-text-dim text-xs">{skill.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
