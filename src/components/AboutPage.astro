---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section about-section">
  <div class="container">
    <a class="back" href={localizedPath('/', lang)}>&larr; {t('nav.home')}</a>

    <h1>{t('about.heading')}</h1>
    <div class="about-grid">
      <div class="prose">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>
      <aside class="card now-card">
        <h3>{t('about.nowHeading')}</h3>
        <p>{t('about.nowText')}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  h1 + .about-grid {
    margin-top: var(--space-6);
  }

  .about-grid {
    display: grid;
    gap: var(--space-5);
  }
  .now-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }
</style>
