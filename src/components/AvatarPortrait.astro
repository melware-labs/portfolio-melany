---
/**
 * Retrato grande de Melany, protagonista del hero. Ilustración plana
 * con sombreado degradado (tipo "emoji 3D") y un contorno fino que
 * unifica las formas — sin ese contorno cualquier imperfección de
 * proporción se nota mucho más.
 *
 * Rasgos a partir de su propia descripción: pelo castaño/rojizo con
 * raya en medio, gafas grandes de pasta negra, auriculares de diadema
 * color crema, sudadera negra. Ilustración original.
 */
---

<div class="avatar-portrait" aria-hidden="true">
  <svg viewBox="0 0 480 620" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="ap-skin" cx="35%" cy="26%" r="85%">
        <stop offset="0%" stop-color="#f6d0ac" />
        <stop offset="58%" stop-color="#e3ab7c" />
        <stop offset="100%" stop-color="#c88f61" />
      </radialGradient>
      <linearGradient id="ap-hair" x1="0.1" y1="0" x2="0.35" y2="1">
        <stop offset="0%" stop-color="#a05f47" />
        <stop offset="100%" stop-color="#63311f" />
      </linearGradient>
      <linearGradient id="ap-hoodie" x1="0.2" y1="0" x2="0.6" y2="1">
        <stop offset="0%" stop-color="#302d38" />
        <stop offset="100%" stop-color="#15141a" />
      </linearGradient>
      <linearGradient id="ap-cushion" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fdf6e8" />
        <stop offset="100%" stop-color="#e9d9b8" />
      </linearGradient>
      <filter id="ap-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
    </defs>

    <!-- resplandor ambiental, respira despacio -->
    <ellipse class="ap-glow ap-glow--a" cx="205" cy="220" rx="180" ry="180" filter="url(#ap-soft)" />
    <ellipse class="ap-glow ap-glow--b" cx="345" cy="400" rx="150" ry="150" filter="url(#ap-soft)" />

    <g class="ap-lines" stroke="#241b14" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
      <!-- sudadera / hombros -->
      <path class="ap-hoodie" d="M86 620 C86 510 148 458 240 458 C332 458 394 510 394 620 Z" fill="url(#ap-hoodie)" />
      <path class="ap-hood" d="M158 462 C182 494 210 508 240 508 C270 508 298 494 322 462" fill="none" stroke="#0e0d12" stroke-width="6" opacity="0.55" />
      <path d="M224 470 L218 536 M256 470 L262 536" stroke="#0e0d12" stroke-width="5" stroke-linecap="round" />
      <circle cx="218" cy="540" r="4.5" fill="#0e0d12" stroke="none" />
      <circle cx="262" cy="540" r="4.5" fill="#0e0d12" stroke="none" />

      <!-- cuello (más ancho de lo estricto, para que la sudadera lo tape sin dejar hueco) -->
      <rect x="195" y="380" width="90" height="120" rx="16" fill="url(#ap-skin)" />

      <!-- orejas -->
      <ellipse cx="128" cy="298" rx="17" ry="25" fill="url(#ap-skin)" />
      <ellipse cx="352" cy="298" rx="17" ry="25" fill="url(#ap-skin)" />

      <!-- cabeza -->
      <path
        class="ap-head"
        d="M240 138 C312 138 350 194 350 270 C350 348 306 404 240 404 C174 404 130 348 130 270 C130 194 168 138 240 138 Z"
        fill="url(#ap-skin)"
      />

      <!-- mofletes -->
      <ellipse cx="186" cy="322" rx="24" ry="14" fill="#e8896a" opacity="0.28" stroke="none" />
      <ellipse cx="294" cy="322" rx="24" ry="14" fill="#e8896a" opacity="0.28" stroke="none" />

      <!-- pelo: gorro con raya en medio -->
      <path
        class="ap-hair"
        d="M130 262 C130 182 178 130 240 130 C302 130 350 182 350 262
           C350 278 345 291 335 300 C330 246 300 196 260 184
           C252 208 245 224 240 224 C235 224 228 208 220 184
           C180 196 150 246 145 300 C135 291 130 278 130 262 Z"
        fill="url(#ap-hair)"
      />
      <path class="ap-hair-side" d="M148 296 C140 332 145 370 162 396 C176 368 178 328 172 292 Z" fill="url(#ap-hair)" />
      <path class="ap-hair-side" d="M332 296 C340 332 335 370 318 396 C304 368 302 328 308 292 Z" fill="url(#ap-hair)" />

      <!-- diadema de los auriculares, pegada a la línea del pelo -->
      <path class="ap-band" d="M166 206 C186 156 294 156 314 206" fill="none" stroke="url(#ap-cushion)" stroke-width="13" />
      <ellipse class="ap-cup" cx="146" cy="288" rx="21" ry="29" fill="url(#ap-cushion)" />
      <ellipse cx="146" cy="288" rx="10" ry="16" fill="#2a2830" stroke="none" />
      <ellipse class="ap-cup" cx="334" cy="288" rx="21" ry="29" fill="url(#ap-cushion)" />
      <ellipse cx="334" cy="288" rx="10" ry="16" fill="#2a2830" stroke="none" />

      <!-- cejas -->
      <path d="M180 258 Q198 247 218 254" fill="none" stroke-width="5" />
      <path d="M262 254 Q282 247 300 258" fill="none" stroke-width="5" />

      <!-- gafas -->
      <g class="ap-glasses">
        <rect x="172" y="266" width="70" height="56" rx="17" fill="none" stroke-width="8" />
        <rect x="238" y="266" width="70" height="56" rx="17" fill="none" stroke-width="8" />
        <path d="M242 292 L238 292" stroke-width="8" />
        <path d="M172 280 L146 288" stroke-width="6" />
        <path d="M308 280 L334 288" stroke-width="6" />
      </g>

      <!-- ojos (parpadean) -->
      <g class="ap-eyes" stroke="none">
        <ellipse cx="207" cy="296" rx="7.5" ry="8.5" fill="#241a14" />
        <circle cx="204.5" cy="292.5" r="2.2" fill="#fff" opacity="0.85" />
        <ellipse cx="273" cy="296" rx="7.5" ry="8.5" fill="#241a14" />
        <circle cx="270.5" cy="292.5" r="2.2" fill="#fff" opacity="0.85" />
      </g>

      <!-- nariz y sonrisa -->
      <path d="M240 300 C238 315 236 326 240 331" stroke="#b5794f" stroke-width="4" />
      <path class="ap-mouth" d="M212 352 Q240 372 268 352" fill="none" stroke="#9a5c42" stroke-width="5" />
    </g>
  </svg>
</div>

<style>
  .avatar-portrait {
    position: relative;
    width: 100%;
    max-width: 27rem;
    margin-inline: auto;
  }
  .avatar-portrait svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .ap-lines {
    animation: ap-bob 6.5s ease-in-out infinite;
    transform-origin: 240px 500px;
  }

  .ap-glow { stroke: none; }
  .ap-glow--a { fill: var(--accent); opacity: 0.32; animation: ap-glow-pulse 7s ease-in-out infinite; }
  .ap-glow--b { fill: var(--accent-cool); opacity: 0.24; animation: ap-glow-pulse 8.5s ease-in-out infinite reverse; }

  .ap-eyes {
    transition: transform 0.09s ease;
    transform-origin: 240px 296px;
  }
  .avatar-portrait.blink .ap-eyes {
    transform: scaleY(0.12);
  }

  @keyframes ap-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @keyframes ap-glow-pulse {
    0%, 100% { transform: scale(1); opacity: 0.32; }
    50% { transform: scale(1.12); opacity: 0.44; }
  }
</style>

<script>
  const root = document.querySelector('.avatar-portrait');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const blink = () => {
      root.classList.add('blink');
      setTimeout(() => root.classList.remove('blink'), 130);
      setTimeout(blink, 2600 + Math.random() * 2600);
    };
    setTimeout(blink, 1400);
  }
</script>
