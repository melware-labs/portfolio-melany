---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = `${localizedPath('/', lang)}#cursos`;
---

<a class="announce" href={href}>
  <span>{t('announce.text')}</span>
  <span aria-hidden="true">&rarr;</span>
</a>

<style>
  /* Barra de aviso sobre la cabecera. Lleva el acento sólido y el texto en
     negro por contraste (4,9 contra 4,2 con blanco), como las chapas. */
  .announce {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    background: var(--accent);
    color: var(--paper);
    font-size: var(--step--1);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .announce:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }
  .announce:focus-visible {
    outline-color: var(--paper);
    outline-offset: -4px;
  }
</style>
