---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-brand">
      <strong>Melware Labs</strong>
      <span>© {year} {t('footer.rights')}</span>
    </p>

    <SocialLinks />
  </div>

  <p class="footer-wordmark" aria-hidden="true">MELANY</p>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--ink);
    background: var(--paper-2);
    padding-block: var(--space-6);
    margin-top: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-brand strong {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer-brand span {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  /* Marca gigante y difuminada de fondo — puramente decorativa, el
     nombre ya está en texto real más arriba, así que se oculta a
     lectores de pantalla. */
  .footer-wordmark {
    margin-top: var(--space-7);
    overflow: hidden;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15vw;
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 12%, transparent);
    user-select: none;
    pointer-events: none;
  }
</style>
