---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const home = localizedPath('/', lang);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-brand">
      <strong>Melware Labs</strong>
      <span>© {year} {t('footer.rights')}</span>
    </p>

    <SocialLinks />

    <a class="footer-logo" href={home} aria-label={t('nav.home')}>
      <img src="/favicon.png" alt="" width="32" height="32" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  /* Mismo tono que la cabecera (--paper), no un bloque de color aparte:
     el pie cierra la página en vez de destacar como una franja distinta. */
  .site-footer {
    border-top: var(--border-width) solid var(--line-faint);
    background: var(--paper);
    color: var(--ink-soft);
    padding-block: var(--space-7) var(--space-6);
    margin-top: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-brand strong {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Micro-texto en mayúsculas muy espaciado, como la línea legal de la
     referencia: se lee si lo buscas y desaparece si no. */
  .footer-brand span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.8;
  }

  /* Misma marca del favicon, como remate central del pie. */
  .footer-logo {
    display: grid;
    place-items: center;
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }
  .footer-logo:hover,
  .footer-logo:focus-visible {
    opacity: 1;
  }
  .footer-logo img {
    display: block;
    width: 2rem;
    height: 2rem;
  }

  .site-footer :global(.social-links a) {
    color: var(--accent);
  }
  /* Invierte el par de colores en vez de sólo cambiar uno: icono y fondo
     se intercambian al pasar el cursor. */
  .site-footer :global(.social-links a:hover) {
    color: var(--paper);
    background: var(--accent);
  }

  @media (min-width: 40rem) {
    .footer-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-5);
      text-align: left;
    }
    .footer-brand {
      justify-self: start;
    }
    .site-footer :global(.social-links) {
      justify-self: center;
    }
    .footer-logo {
      justify-self: end;
    }
  }
</style>
