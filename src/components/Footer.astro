---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-brand">
      <strong>Melware Labs</strong>
      <span>© {year} {t('footer.rights')}</span>
    </p>

    <SocialLinks />
  </div>
</footer>

<style>
  /* Negro opaco y una línea casi invisible: el pie cierra la página en
     vez de destacar como una franja más clara, que era lo que hacía
     antes con --paper-2. */
  .site-footer {
    border-top: var(--border-width) solid var(--line-faint);
    background: var(--paper);
    padding-block: var(--space-7) var(--space-6);
    margin-top: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-brand strong {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Micro-texto en mayúsculas muy espaciado, como la línea legal de la
     referencia: se lee si lo buscas y desaparece si no. */
  .footer-brand span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
