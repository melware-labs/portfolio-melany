---
import { getLangFromUrl, useTranslations, localizedPath, alternatePath, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizedPath('/', lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const otherHref = alternatePath(Astro.url, lang);

const links = [
  { href: `${home}#sobre-mi`, label: t('nav.about') },
  { href: `${home}#proyectos`, label: t('nav.projects') },
  { href: `${home}#blog`, label: t('nav.blog') },
  { href: `${home}#contacto`, label: t('nav.contact') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>
      <span class="brand-name">Melany</span>
      <span class="brand-labs">Melware Labs</span>
    </a>

    <nav class="nav-desktop" aria-label={t('nav.menu')}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="lang-switch" href={otherHref} lang={otherLang} hreflang={otherLang} aria-label={t('nav.switchTo')}>
        {languages[otherLang]}
      </a>

      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="visually-hidden">{t('nav.openMenu')}</span>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label={t('nav.menu')} hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-block: var(--space-4) var(--space-3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem;
    background: color-mix(in srgb, var(--paper) 68%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: var(--border-width) solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 9999px;
    padding-inline: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.1;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .brand-labs {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .nav-desktop {
    display: none;
    margin-inline-start: auto;
    gap: var(--space-5);
  }
  .nav-desktop a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }
  .nav-desktop a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    border: var(--border-width) solid var(--ink);
    border-radius: 9999px;
    background: var(--surface);
  }
  .lang-switch:hover {
    background: var(--paper-2);
    color: var(--ink);
  }

  /* ── Botón hamburguesa ─────────────────────────────────────── */
  .menu-toggle {
    /* 44x44: objetivo táctil mínimo cómodo */
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: var(--border-width) solid var(--ink);
    border-radius: 9999px;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Menú desplegable ──────────────────────────────────────── */
  .nav-mobile {
    display: grid;
    border-top: var(--border-width) solid var(--ink);
    background: var(--surface);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile a {
    padding: var(--space-4) var(--space-5);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--paper-2);
  }
  .nav-mobile a:last-child {
    border-bottom: none;
  }
  .nav-mobile a:hover {
    background: var(--paper-2);
  }

  /* A partir de tablet: navegación completa y fuera la hamburguesa */
  @media (min-width: 48rem) {
    .nav-desktop {
      display: flex;
    }
    .header-actions {
      margin-inline-start: 0;
    }
    .menu-toggle {
      display: none;
    }
    .nav-mobile {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  if (toggle && nav) {
    const open = () => {
      nav.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      // Evita que el fondo haga scroll mientras el menú está abierto
      document.body.style.overflow = 'hidden';
    };

    const close = ({ refocus = false } = {}) => {
      nav.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (refocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    // Al pulsar un enlace el menú debe desaparecer, si no tapa la sección
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;

      if (e.key === 'Escape') {
        close({ refocus: true });
        return;
      }

      // Mientras está abierto, el tabulador se queda dentro del menú
      if (e.key === 'Tab') {
        const items = [toggle, ...Array.from(nav.querySelectorAll('a'))];
        const first = items[0];
        const last = items[items.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          (last as HTMLElement).focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          (first as HTMLElement).focus();
        }
      }
    });

    // Si se ensancha la ventana hasta escritorio, el menú sobra
    const desktop = window.matchMedia('(min-width: 48rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
