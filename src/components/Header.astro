---
import { getLangFromUrl, useTranslations, localizedPath, alternatePath, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizedPath('/', lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const otherHref = alternatePath(Astro.url, lang);

const links = [
  { href: `${home}#sobre-mi`, label: t('nav.about') },
  { href: `${home}#proyectos`, label: t('nav.projects') },
  { href: `${home}#blog`, label: t('nav.blog') },
  { href: `${home}#contacto`, label: t('nav.contact') },
];

const flagSrc: Record<string, string> = {
  es: 'https://flagcdn.com/w40/es.png',
  en: 'https://flagcdn.com/w40/gb.png',
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>
      <span class="brand-mark" aria-hidden="true">&lt;</span>
      <span class="brand-name">Melany</span>
    </a>

    <nav class="nav-desktop" aria-label={t('nav.menu')}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <div class="lang-dropdown" id="lang-dropdown">
        <button
          class="lang-toggle"
          type="button"
          id="lang-toggle"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={t('nav.language')}
        >
          <img class="lang-flag" src={flagSrc[lang]} alt="" width="20" height="15" />
          <span class="lang-code">{lang.toUpperCase()}</span>
          <svg class="lang-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3 5 6 8 9 5"></polyline>
          </svg>
        </button>
        <div class="lang-menu" id="lang-menu" role="menu" hidden>
          <a
            class:list={['lang-option', { 'is-active': lang === 'es' }]}
            href={lang === 'es' ? '#' : alternatePath(Astro.url, 'en')}
            role="menuitem"
            lang="es"
            hreflang="es"
            aria-current={lang === 'es' ? 'true' : undefined}
          >
            <img class="lang-flag" src={flagSrc.es} alt="" width="20" height="15" />
            <span>Español</span>
          </a>
          <a
            class:list={['lang-option', { 'is-active': lang === 'en' }]}
            href={lang === 'en' ? '#' : alternatePath(Astro.url, 'es')}
            role="menuitem"
            lang="en"
            hreflang="en"
            aria-current={lang === 'en' ? 'true' : undefined}
          >
            <img class="lang-flag" src={flagSrc.en} alt="" width="20" height="15" />
            <span>English</span>
          </a>
        </div>
      </div>

      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="visually-hidden">{t('nav.openMenu')}</span>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label={t('nav.menu')} hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-bottom: var(--border-width) solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem;
    padding-block: var(--space-2);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.15em;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.1;
  }
  .brand-mark {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--accent);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
  }

  /* ── Nav centrada ─────────────────────────────────────────── */
  .nav-desktop {
    display: none;
    gap: var(--space-5);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-desktop a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nav-desktop a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  /* ── Dropdown de idioma ──────────────────────────────────── */
  .lang-dropdown {
    position: relative;
  }
  .lang-toggle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: var(--space-2) var(--space-4);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .lang-toggle:hover {
    color: var(--ink);
    border-color: var(--accent);
    box-shadow: var(--glow);
  }
  .lang-flag {
    width: 20px;
    height: 15px;
    object-fit: cover;
    border-radius: 2px;
    vertical-align: middle;
  }
  .lang-chevron {
    transition: transform 0.2s ease;
  }
  .lang-toggle[aria-expanded='true'] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 10rem;
    background: var(--paper);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .lang-menu:not([hidden]) {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .lang-menu[hidden] {
    display: block !important;
    visibility: hidden;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: var(--space-3) var(--space-4);
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .lang-option:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .lang-option.is-active {
    color: var(--accent);
    font-weight: 600;
  }
  .lang-option + .lang-option {
    border-top: var(--border-width) solid var(--line-faint);
  }

  /* ── Botón hamburguesa ─────────────────────────────────────── */
  .menu-toggle {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Menú desplegable móvil ──────────────────────────────── */
  .nav-mobile {
    display: grid;
    border-top: var(--border-width) solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile a {
    padding: var(--space-4) var(--space-5);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    border-bottom: var(--border-width) solid var(--line-faint);
  }
  .nav-mobile a:last-child {
    border-bottom: none;
  }
  .nav-mobile a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .header-inner {
      position: relative;
    }
    .nav-desktop {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
    .nav-mobile {
      display: none !important;
    }
  }
</style>

<script>
  // ── Menú hamburguesa ────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  if (toggle && nav) {
    const open = () => {
      nav.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = ({ refocus = false } = {}) => {
      nav.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (refocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;

      if (e.key === 'Escape') {
        close({ refocus: true });
        return;
      }

      if (e.key === 'Tab') {
        const items = [toggle, ...Array.from(nav.querySelectorAll('a'))];
        const first = items[0];
        const last = items[items.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          (last as HTMLElement).focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          (first as HTMLElement).focus();
        }
      }
    });

    const desktop = window.matchMedia('(min-width: 48rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }

  // ── Dropdown de idioma ──────────────────────────────────────
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');

  if (langToggle && langMenu) {
    const openLang = () => {
      langMenu.hidden = false;
      langToggle.setAttribute('aria-expanded', 'true');
    };

    const closeLang = () => {
      langMenu.hidden = true;
      langToggle.setAttribute('aria-expanded', 'false');
    };

    langToggle.addEventListener('click', () => {
      const isOpen = langToggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeLang() : openLang();
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#lang-dropdown')) {
        closeLang();
      }
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langToggle.getAttribute('aria-expanded') === 'true') {
        closeLang();
        langToggle.focus();
      }
    });
  }
</script>
