---
// Projects section with filter functionality
const projects = [
  {
    title: 'TaskFlow App',
    desc: 'Aplicación de gestión de tareas con sistema de usuarios, tableros Kanban y colaboración en tiempo real.',
    tags: ['React', 'Node.js', 'MongoDB', 'WebSockets'],
    filterTags: 'web backend',
    featured: false,
    color: 'primary',
    github: '#',
    demo: '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>`,
  },
  {
    title: 'SentimentAI',
    desc: 'Modelo de análisis de sentimientos entrenado con reviews en español. API REST lista para producción con FastAPI.',
    tags: ['Python', 'FastAPI', 'Scikit-learn', 'Docker'],
    filterTags: 'ia backend',
    featured: true,
    color: 'accent',
    github: '#',
    demo: null,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a2 2 0 012 2v2a2 2 0 01-2 2 2 2 0 01-2-2V4a2 2 0 012-2z"/><path d="M12 16a2 2 0 012 2v2a2 2 0 01-2 2 2 2 0 01-2-2v-2a2 2 0 012-2z"/><path d="M4 12a2 2 0 012-2h2a2 2 0 012 2 2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M16 12a2 2 0 012-2h2a2 2 0 012 2 2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  },
  {
    title: 'DevNotes CLI',
    desc: 'Herramienta de línea de comandos para gestionar snippets de código. Búsqueda full-text, etiquetas y sincronización.',
    tags: ['Python', 'CLI', 'SQLite'],
    filterTags: 'tool web',
    featured: false,
    color: 'green',
    github: '#',
    demo: '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    title: 'UMA Schedule API',
    desc: 'API REST que extrae y expone los horarios de la UMA en formato estructurado. Usada por compañeros para crear apps.',
    tags: ['Java', 'Spring Boot', 'PostgreSQL'],
    filterTags: 'backend web',
    featured: false,
    color: 'purple',
    github: '#',
    demo: null,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>`,
  },
];

const filters = [
  { label: 'Todos', value: 'all' },
  { label: 'Web', value: 'web' },
  { label: 'IA / ML', value: 'ia' },
  { label: 'Backend', value: 'backend' },
  { label: 'Herramienta', value: 'tool' },
];

const colorMap: Record<string, { icon: string; border: string }> = {
  primary: { icon: 'text-primary bg-primary/10', border: 'border-primary/30' },
  accent: { icon: 'text-accent bg-accent/10', border: 'border-accent/30' },
  green: { icon: 'text-green bg-green/10', border: 'border-green/30' },
  purple: { icon: 'text-purple bg-purple/10', border: 'border-purple/30' },
};
---

<section id="proyectos" class="py-(--section-padding) scroll-mt-20">
  <div class="max-w-(--container-max) mx-auto px-6">
    <!-- Header -->
    <header class="text-center mb-12" data-reveal>
      <p class="text-primary text-sm font-mono font-medium uppercase tracking-wider mb-3">Proyectos</p>
      <h2 class="font-display font-bold text-3xl md:text-4xl text-text mb-4">Lo que he construido</h2>
      <p class="text-text-muted max-w-xl mx-auto">Proyectos propios donde aplico lo que aprendo. Desde ideas sencillas hasta retos más complejos.</p>
    </header>

    <!-- Filters -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10" data-reveal data-reveal-delay="1">
      {filters.map((f, i) => (
        <button
          class={`px-4 py-1.5 rounded-full text-sm font-medium border transition-all duration-200 cursor-pointer ${
            i === 0
              ? 'bg-primary/10 text-primary border-primary/30'
              : 'bg-transparent text-text-muted border-border hover:border-border-hover hover:text-text'
          }`}
          data-filter={f.value}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 gap-5" id="projects-grid">
      {projects.map((p, i) => (
        <article
          class={`relative rounded-xl border bg-bg-card hover:bg-bg-card-hover transition-all duration-300 group overflow-hidden ${
            p.featured ? `border-${p.color}/20 shadow-[0_0_30px_rgba(244,114,182,0.08)]` : 'border-border hover:border-border-hover'
          }`}
          data-tags={p.filterTags}
          data-reveal
          data-reveal-delay={String(i % 3)}
        >
          <div class="p-6">
            <!-- Header -->
            <div class="flex items-start justify-between mb-4">
              <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${colorMap[p.color].icon}`}>
                <Fragment set:html={p.icon} />
              </div>
              <div class="flex items-center gap-3">
                {p.featured && (
                  <span class="text-[10px] font-bold uppercase tracking-wider text-accent bg-accent/10 px-2 py-0.5 rounded">Destacado</span>
                )}
                <div class="flex items-center gap-2">
                  {p.github && (
                    <a href={p.github} class="text-text-dim hover:text-text transition-colors" title="GitHub" aria-label="Ver código en GitHub">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12z"/></svg>
                    </a>
                  )}
                  {p.demo && (
                    <a href={p.demo} class="text-text-dim hover:text-text transition-colors" title="Demo" aria-label="Ver demo">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
            <!-- Content -->
            <h3 class="font-display font-semibold text-text text-lg mb-2">{p.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed mb-4">{p.desc}</p>
            <div class="flex flex-wrap gap-2">
              {p.tags.map(tag => (
                <span class="text-[11px] font-medium text-text-dim bg-surface px-2.5 py-1 rounded-md border border-border">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10" data-reveal>
      <a
        href="https://github.com/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-text-muted text-sm font-medium hover:text-text transition-colors no-underline"
      >
        Ver todos los proyectos en GitHub
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Project filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const projectCards = document.querySelectorAll<HTMLElement>('#projects-grid article');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-primary/10', 'text-primary', 'border-primary/30');
        b.classList.add('bg-transparent', 'text-text-muted', 'border-border');
      });
      btn.classList.add('bg-primary/10', 'text-primary', 'border-primary/30');
      btn.classList.remove('bg-transparent', 'text-text-muted', 'border-border');

      const filter = btn.dataset.filter;
      projectCards.forEach(card => {
        const tags = card.dataset.tags || '';
        if (filter === 'all' || tags.includes(filter!)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
