---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import BlogListing from '../../../../components/blog/BlogListing.astro';
import { useTranslations, localizedPath, type UIKey } from '../../../../i18n/ui';
import { CATEGORY_ORDER, CATEGORY_LABEL_KEY, type BlogCategory } from '../../../../data/blog-categories';

// Same as the Spanish version, only generates a page per category that
// actually has a published English post.
export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en' && !p.data.draft);
  const categoriesWithPosts = CATEGORY_ORDER.filter((cat) => posts.some((p) => p.data.category === cat));

  return categoriesWithPosts.map((categoria) => ({
    params: { categoria },
    props: { categoria },
  }));
}

const { categoria } = Astro.props as { categoria: BlogCategory };
const t = useTranslations('en');
const label = t(`blog.category.${CATEGORY_LABEL_KEY[categoria]}` as UIKey);

/**
 * This same category in Spanish only exists if there is a Spanish post in it:
 * routes are generated per language (see getStaticPaths). As soon as the
 * categories differ between languages, switching would land on a URL that was
 * never generated, so with no counterpart it falls back to the Spanish list.
 */
const esPosts = await getCollection('blog', (p) => p.data.lang === 'es' && !p.data.draft);
const alternate = esPosts.some((p) => p.data.category === categoria)
  ? localizedPath(`/blog/categoria/${categoria}`, 'es')
  : localizedPath('/blog', 'es');
---

<Base
  title={`${label} — ${t('blog.heading')} | Melany Martínez`}
  description={t('blog.intro')}
  alternate={alternate}
>
  <section class="section">
    <div class="container">
      <h1>{t('blog.heading')} — {label}</h1>
      <p class="section-intro prose">{t('blog.intro')}</p>
      <BlogListing activeCategory={categoria} />
    </div>
  </section>
</Base>
